---
import InstagramIcon from "./icons/InstagramIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import WhatsappIcon from "./icons/WhatsappIcon.astro";
interface Props {
  landing?: boolean;
}

const { landing = false } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__logo">
      <a class="site-logo" href="/">
        <img src="/logo-256.png" alt="Cielo Artuso" width="256" height="256" />

        <div class="site-logo__text">
          <span class="site-logo__name">
            Cielo<br />
            Artuso
          </span>

          <p class="eyebrow">Web Developer · Milano</p>
        </div>
      </a>

      <div class="site-footer__privacy-cookie">
        <a href="/privacy-policy">Privacy e Cookie Policy</a>
      <button
        type="button"
        id="manage-cookie-preferences"
        class="footer__cookie-button"
      >
        Preferenze cookie
      </button>
      </div>

    </div>

    <div class="site-footer__nav">
      {!landing &&
      <h3>Navigazione</h3>
      <a href="/servizi">Servizi</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/blog">Blog</a>
      <a href="/chi-sono">Chi sono</a>
      <a href="/contatti">Contatti</a>
      <a href="/analisi-sito">Analisi gratuita del sito</a>
      }
    </div>

    <div class="site-footer__services">
      {!landing &&
      <h3>Servizi</h3>
      <a href="/servizi/rifacimento-siti-web">Rifacimento siti web</a>
      <a href="/servizi/siti-web-su-misura">Siti web su misura</a>
      <a href="/servizi/web-app-gestionali">Web app e gestionali</a>
      <a href="/servizi/manutenzione-siti-web">Manutenzione siti web</a>
      }
    </div>

    <div class="site-footer__contacts">
      <h3>Contatti</h3>
      <a href="mailto:info@cieloartuso.com">info@cieloartuso.com</a>
      <p>Milano, IT</p>
      <div class="social">
        <a
          href="https://wa.me/393488785699?text=Ciao%2C%20vorrei%20ricevere%20informazioni%20sui%20tuoi%20servizi."
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contattami su WhatsApp"
        >
          <WhatsappIcon />
        </a>
        <a
          href="https://www.instagram.com/cieloartuso"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Profilo Instagram Cielo Artuso"
        >
          <InstagramIcon />
        </a>
        <a
          href="https://github.com/scepedanzale"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Profilo Github di Cielo Artuso"
        >
          <GithubIcon />
        </a>
      </div>
    </div>
  </div>

  <div class="site-footer__copy">
    <p>©2026 Cielo Artuso</p>
  </div>
</footer>

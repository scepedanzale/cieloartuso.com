---
import ImageIcon from "../components/icons/ImageIcon.astro";
import PcIcon from "../components/icons/PcIcon.astro";
import LockIcon from "../components/icons/LockIcon.astro";
import CheckIcon from "../components/icons/CheckIcon.astro";
import WaveLine from "../components/WaveLine.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/icons/ArrowIcon.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { getCollection } from "astro:content";

const reviews = (
  await getCollection("reviews", ({ data }) => data.draft !== true)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: Astro.url.href,
  name: "Chi sono | Cielo Artuso",
  mainEntity: {
    "@type": "Person",
    "@id": "https://www.cieloartuso.com/#person",
    name: "Cielo Artuso",
    jobTitle: "Web Developer",
    url: "https://www.cieloartuso.com/",
  },
};
---

<BaseLayout
  title="Chi sono | Cielo Artuso"
  description="Mi chiamo Cielo e creo siti web curati per chi vuole presentarsi meglio online"
  structuredData={structuredData}
  image="/images/site/cielo-artuso.webp"
  imageAlt="Cielo Artuso"
>
  <div class="chi-sono-page">
    <section class="page-hero">
      <header class="container">
        <div>
          <p class="eyebrow">Web developer</p>
          <h1>Chi sono</h1>
          <WaveLine />
          <div class="intro reveal">
            <p>
              <strong>Ciao, sono Cielo</strong>, web developer con sede a Milano
              e, da remoto, ovunque.
            </p>
            <br />
            <p>
              Progetto e sviluppo siti web e web app su misura: dalla vetrina di
              un’attività locale al gestionale che ti fa risparmiare ore di
              lavoro ogni settimana.
            </p>
            <p>
              Il mio modo di lavorare si riassume così: la tecnologia giusta,
              senza sprechi, e un percorso in cui sai sempre a che punto siamo.
            </p>
            <a href="#perche-me" class="button button--primary">
              Perché scegliere me
              <ArrowIcon />
            </a>
          </div>
        </div>
        <img
          src="/images/site/cielo-artuso.webp"
          alt="Cielo Artuso"
          class="reveal"
        />
      </header>
    </section>

    <!-- PERCHÉ SCEGLIERE ME -->
    <section id="perche-me" class="reasons">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Perché scegliere me</p>
          <h2>Sai sempre a che punto siamo</h2>
          <p>
            Lavorare con me significa avere un processo chiaro dall’inizio alla
            fine, e qualcuno che ti guida in ogni passaggio.
          </p>
        </div>

        <div class="reasons__portal reveal">
          <div>
            <h3>Un portale dedicato per seguire il tuo progetto</h3>
            <p>
              Dal primo giorno alla consegna hai accesso a uno spazio riservato
              in cui vedi a che punto sono i lavori, quali passi sono stati
              completati e cosa succede dopo. <br /> Niente email perse o
              domande del tipo “a che punto siamo?”: è tutto lì, sempre
              aggiornato.
            </p>
          </div>

          <ul>
            <li><CheckIcon /> Avanzamento del progetto passo dopo passo</li>
            <li><CheckIcon /> Prossimi passi sempre chiari</li>
            <li><CheckIcon /> Cosa serve da parte tua, e quando</li>
          </ul>
        </div>

        <ul class="reasons__list">
          <li class="reveal">
            <ImageIcon />
            <div>
              <h3>Attenzione alla parte visiva</h3>
              <p>
                Disegno da sempre e vengo da un percorso artistico. Equilibrio,
                colori, composizione e dettagli sono la prima cosa che guardo:
                un sito deve funzionare, ma anche rappresentarti.
              </p>
            </div>
          </li>

          <li class="reveal d1">
            <PcIcon />
            <div>
              <h3>Su misura, non adattato</h3>
              <p>
                Ogni progetto nasce attorno alla tua attività, non da un tema
                già pronto da riempire. <br /> Mi sono formato nello sviluppo
                web e software full stack: dal sito vetrina alla web app con
                database.
              </p>
            </div>
          </li>

          <li class="reveal d2">
            <LockIcon />
            <div>
              <h3>Anche ciò che non si vede</h3>
              <p>
                Ho approfondito networking, sicurezza e gestione dei sistemi.
                <br /> Per questo guardo un sito anche dal lato tecnico: hosting,
                prestazioni, sicurezza e manutenzione nel tempo.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="approach">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Come lavoriamo insieme</p>
          <h2>Ti guido io, dall’inizio alla fine</h2>
          <p>
            Non serve arrivare con un’idea perfetta, una mappa del sito già
            pronta o parole tecniche da usare. <br /> Il mio lavoro parte proprio
            da qui: fare le domande giuste, mettere ordine e trasformare le idee in
            qualcosa di chiaro, utile e concreto.
          </p>
        </div>

        <div class="approach__steps">
          <article class="approach-step reveal">
            <span class="approach-step__number">01</span>
            <div class="approach-step__content">
              <p class="approach-step__label">Prima call</p>
              <h3>Non devi preparare un discorso perfetto</h3>
              <p>
                Ti faccio io le domande utili per capire chi sei, cosa fai, cosa
                vuoi comunicare e cosa deve ottenere il sito. Anche se hai solo
                idee confuse, va benissimo: partiamo da quelle.
              </p>
            </div>
          </article>

          <article class="approach-step reveal">
            <span class="approach-step__number">02</span>
            <div class="approach-step__content">
              <p class="approach-step__label">Direzione</p>
              <h3>Mettiamo ordine nelle cose</h3>
              <p>
                Insieme capiamo cosa serve davvero, cosa si può semplificare e
                quale struttura ha più senso. L’obiettivo è evitare confusione,
                pagine inutili e funzionalità messe solo “perché si fa così”.
              </p>
            </div>
          </article>

          <article class="approach-step reveal">
            <span class="approach-step__number">03</span>
            <div class="approach-step__content">
              <p class="approach-step__label">Sviluppo</p>
              <h3>Vedi il sito prendere forma, passo dopo passo</h3>
              <p>
                Ogni avanzamento lo trovi nel tuo portale: cosa è stato fatto,
                cosa sto facendo e cosa viene dopo. Non sparisco fino alla
                consegna: ti mostro il lavoro, ti spiego le scelte importanti e
                il processo resta sempre comprensibile.
              </p>
            </div>
          </article>

          <article class="approach-step reveal">
            <span class="approach-step__number">04</span>
            <div class="approach-step__content">
              <p class="approach-step__label">Consegna</p>
              <h3>Alla fine sai cosa hai in mano</h3>
              <p>
                Il sito non viene solo pubblicato: viene consegnato in modo
                ordinato. Ti spiego cosa è stato fatto, come funziona e come
                gestirlo nel tempo, senza lasciarti con qualcosa di tecnico e
                incomprensibile.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- RECENSIONI -->
    {
      reviews.length > 0 && (
        <section id="recensioni" class="reviews">
          <div class="container">
            <div class="section-heading">
              <p class="eyebrow">Recensioni</p>
              <h2>Cosa dice chi ha lavorato con me</h2>
            </div>

            <div class="reviews-slider reveal">
              <div class="reviews-slider__track" tabindex="0" aria-label="Recensioni">
                {reviews.map((review) => (
                  <ReviewCard review={review} />
                ))}
              </div>

              <div class="reviews-slider__controls">
                <button
                  type="button"
                  class="reviews-slider__button"
                  data-direction="-1"
                  aria-label="Recensione precedente"
                >
                  <span>←</span>
                </button>
                <button
                  type="button"
                  class="reviews-slider__button"
                  data-direction="1"
                  aria-label="Recensione successiva"
                >
                  <span>→</span>
                </button>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section id="sostenibile" class="sustainable container">
      <div class="sustainable__content reveal">
        <div class="sustainable__intro">
          <p class="eyebrow">Solo ciò che serve davvero</p>

          <h2>Ogni tecnologia dovrebbe avere un motivo per esserci</h2>

          <WaveLine tone="light" />
        </div>

        <div class="sustainable__text">
          <div>
            <p>
              Per me sviluppare bene significa partire da ciò che serve davvero. <br
              />
              Cerco di costruire <strong>soluzioni semplici da usare, efficienti e pensate
              per durare</strong>.
            </p>

            <p>
              Ogni sezione, funzionalità, automazione o tecnologia dovrebbe
              avere un motivo concreto per esserci. <br />Evito strutture
              inutilmente pesanti, strumenti superflui e soluzioni più complesse
              del necessario. Questo rende un progetto più veloce, più semplice
              da mantenere e spesso anche meno dispendioso in termini di
              risorse.
            </p>

            <p>
              A volte la soluzione migliore è un sito molto leggero. <br> Altre volte
              può essere una web app, un'automazione o uno strumento basato
              sull'intelligenza artificiale.
            </p>

            <p><strong>L'obiettivo non è usare meno tecnologia possibile, ma usare quella giusta</strong>.</p>
          </div>

          <div>
            <div class="sustainable__box">
              <h3>Perché non parto quasi mai da WordPress?</h3>

              <p>
                WordPress può essere utile quando serve un CMS completo, ma per
                molti siti vetrina <b>introduce più struttura del necessario</b
                >: temi, plugin, aggiornamenti, codice extra e maggiore
                manutenzione.
              </p>
            </div>

            <div class="sustainable__cta">
              <p>
                Hai già un sito WordPress e vuoi tenerlo aggiornato, protetto e
                in ordine?
              </p>

              <a
                href="/servizi/manutenzione-siti-web"
                class="button button--primary"
              >
                Scopri il servizio di manutenzione
                <ArrowIcon />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="about-more">
      <div class="container">
        <div>
          <img
            src="/images/site/cielo-artuso-bici.webp"
            alt="Visione dall'alto di una bicicletta"
          />
        </div>
        <div class="about-more__content reveal">
          <div class="section-heading">
            <p class="eyebrow">Curiosità</p>
            <h2>Altro su di me</h2>
          </div>
          <ul class="free-time__tags">
            <li>
              <ArrowIcon />
              Natura e montagna come filosofia di vita
            </li>
            <li>
              <ArrowIcon />
              Faccio volontariato in gattile, e mi ricorda sempre quanto è importante
              far conoscere le piccole realtà
            </li>
            <li>
              <ArrowIcon />
              Guardo film horror come non ci fosse un domani
            </li>
            <li>
              <ArrowIcon />
              Amo leggere, la musica e andare in bici
            </li>
            <li>
              <ArrowIcon />
              Costruire ma anche smontare le cose e capire come funzionano mi da un
              sacco di soddisfazione
            </li>
            <li>
              <ArrowIcon />
              Ho un'esagerata conoscenza di dinosauri e Pokémon
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll(".reviews-slider").forEach((slider) => {
    const track = slider.querySelector(".reviews-slider__track");
    const buttons = slider.querySelectorAll<HTMLButtonElement>(
      ".reviews-slider__button",
    );

    if (!(track instanceof HTMLElement)) return;

    const updateButtons = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;

      slider.classList.toggle("is-scrollable", maxScroll > 1);

      buttons.forEach((button) => {
        const direction = Number(button.dataset.direction);
        button.disabled =
          direction < 0
            ? track.scrollLeft <= 1
            : track.scrollLeft >= maxScroll - 1;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const card = track.firstElementChild;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const step = card instanceof HTMLElement ? card.offsetWidth + gap : track.clientWidth;

        track.scrollBy({
          left: step * Number(button.dataset.direction),
          behavior: "smooth",
        });
      });
    });

    track.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  });
</script>

---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import ArrowIcon from "../../components/icons/ArrowIcon.astro";
import CheckIcon from "../../components/icons/CheckIcon.astro";

export async function getStaticPaths() {
    const works = await getCollection("works");
    const software = await getCollection("software");

    return [...works, ...software].map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const isSoftware = project.collection === "software";

// Dati comuni ai due tipi di progetto (siti web e software)
const toCard = (item) => ({
    id: item.id,
    title: item.data.title,
    label: item.collection === "software" ? item.data.type : item.data.tipo,
    year: item.data.year,
    cover: item.data.cover,
});

const allProjects = [
    ...(await getCollection("works")),
    ...(await getCollection("software")),
];

// Prima i progetti dello stesso tipo, poi gli altri
const relatedProjects = allProjects
    .filter((item) => item.id !== project.id)
    .sort(
        (a, b) =>
            Number(b.collection === project.collection) -
                Number(a.collection === project.collection) ||
            b.data.year - a.data.year,
    )
    .slice(0, 3)
    .map(toCard);

const projectType = isSoftware ? project.data.type : project.data.tipo;
// La cover è la prima immagine della galleria
const gallery = isSoftware ? [project.data.cover, ...project.data.images] : [];

const structuredData = {
    "@context": "https://schema.org",
    "@type": isSoftware ? "SoftwareApplication" : "CreativeWork",
    name: project.data.title,
    description: project.data.description,
    url: Astro.url.href,

    creator: {
        "@id": "https://www.cieloartuso.com/#person",
    },

    dateCreated: String(project.data.year),

    ...(isSoftware
        ? { applicationCategory: "WebApplication", operatingSystem: "Web" }
        : { genre: projectType }),

    ...(project.data.cover && {
        image: new URL(project.data.cover, Astro.site).href,
    }),
};
---

<BaseLayout
    title={`${project.data.title} | Cielo Artuso`}
    description={project.data.description}
    structuredData={structuredData}
>
    <article class="project-page">
        <header class="project-hero">
            <div class="container">
                <Breadcrumb activePage={project.data.title} />

                <div class="project-hero__heading">
                    <h1>{project.data.title}</h1>

                    {
                        project.data.href && (
                            <a
                                href={project.data.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="button button--primary"
                            >
                                {isSoftware ? "Vedi il progetto" : "Visita il sito"}
                                <ArrowIcon />
                            </a>
                        )
                    }
                </div>

                <div class="project-hero__details">
                    <div class="project-info-card reveal">
                        <p class="project-info-card__label">
                            Dettagli progetto
                        </p>

                        <dl class="project-meta">
                            <div>
                                <dt>Tipologia</dt>
                                <dd>{projectType}</dd>
                            </div>

                            {
                                !isSoftware && (
                                    <div>
                                        <dt>Settore</dt>
                                        <dd>{project.data.settore}</dd>
                                    </div>
                                )
                            }

                            <div>
                                <dt>Anno</dt>
                                <dd>{project.data.year}</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="project-info-card reveal d1">
                        {
                            isSoftware ? (
                                <>
                                    <p class="project-info-card__label">
                                        Tecnologie
                                    </p>

                                    <ul class="project-technologies">
                                        {project.data.technologies.map((item) => (
                                            <li>{item}</li>
                                        ))}
                                    </ul>
                                </>
                            ) : (
                                <>
                                    <p class="project-info-card__label">
                                        Il mio intervento
                                    </p>

                                    <ul class="project-services">
                                        {project.data.cosaHoFatto.map((item) => (
                                            <li>
                                                <CheckIcon />
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </>
                            )
                        }
                    </div>
                </div>
            </div>
        </header>

        <section class="project-overview">
            <div class="container">
                {
                    gallery.length > 1 ? (
                        <ProjectGallery images={gallery} title={project.data.title} />
                    ) : (
                        <figure class="project-overview__cover">
                            <img
                                src={project.data.cover}
                                alt={`Anteprima del progetto ${project.data.title}`}
                            />
                        </figure>
                    )
                }

                <div class="project-overview__content reveal">
                    <p class="eyebrow">Il progetto</p>
                    <h2>{isSoftware ? "Obiettivi e sviluppo" : "Obiettivi e intervento"}</h2>
                    <Content />
                </div>
            </div>
        </section>

        <!-- ALTRI PROGETTI -->

        <section class="related-projects">
            <div class="container">
                <div class="section-heading related-projects__heading">
                    <p class="eyebrow">Continua a esplorare</p>
                    <h2>Altri progetti</h2>
                </div>

                <div class="projects__grid">
                    {
                        relatedProjects.map((item, i) => (
                            <ProjectCard
                                href={`/portfolio/${item.id}`}
                                cover={item.cover}
                                title={item.title}
                                label={item.label}
                                year={item.year}
                                class={`reveal ${i > 0 ? "d" + i : ""}`}
                            />
                        ))
                    }
                </div>

                <div class="related-projects__action">
                    <a href="/portfolio" class="button button--dark">
                        Vedi tutti i progetti
                        <ArrowIcon />
                    </a>
                </div>
            </div>
        </section>

        <!-- CTA FINALE -->

        <section class="project-page-cta">
            <div class="container">
                <div class="project-page-cta__content reveal">
                    <p class="eyebrow">Hai un progetto simile?</p>

                    <h2>
                        Possiamo costruire qualcosa di adatto alla tua attività
                    </h2>

                    <p>
                        Raccontami cosa vuoi realizzare o migliorare. Partiremo
                        dai tuoi obiettivi per capire quale soluzione può
                        funzionare davvero.
                    </p>
                </div>

                <a href="/contatti" class="button button--dark">
                    Parliamo del progetto
                    <ArrowIcon />
                </a>
            </div>
        </section>
    </article>
</BaseLayout>

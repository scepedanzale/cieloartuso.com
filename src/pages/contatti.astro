---
import InstagramIcon from "../components/icons/InstagramIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import WhatsappIcon from "../components/icons/WhatsappIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/icons/ArrowIcon.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contatti | Cielo Artuso",
  description:
    "Contatta Cielo Artuso per parlare del tuo sito web o progetto digitale.",
  url: Astro.url.href,

  about: {
    "@id": "https://www.cieloartuso.com/#person",
  },
};
---

<BaseLayout
  title="Contatti | Cielo Artuso, sviluppatore web a Milano"
  description="Raccontami cosa ti serve: posso aiutarti a capire come migliorare il tuo sito o crearne uno più adatto alla tua attività."
  structuredData={structuredData}
>
  <div class="contact-page">
    <!-- HERO -->

    <section class="page-hero contact-hero">
      <div class="container">
        <p class="eyebrow">Parliamo del tuo sito</p>

        <h1>Contatti</h1>

        <p class="page-intro">
          Raccontami cosa ti serve: posso aiutarti a capire come migliorare il
          tuo sito o crearne uno più adatto alla tua attività.
        </p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container contact-section__grid">
        <img
          src="/images/site/cielo-artuso-setup.webp"
          alt="Setup di lavoro con due schermi, mouse e tastiera e una lampada da scrivania accesa"
        />

        <div class="contact-info">
          <div class="section-heading contact-info__intro reveal">
            <p class="eyebrow">Un primo confronto</p>

            <h2>Partiamo da quello che ti serve</h2>

            <p>
              Non serve che arrivi con struttura, testi o aspetti tecnici già
              definiti. <br />Tu mi racconti la situazione attuale e l’obiettivo
              che vorresti raggiungere e io trovo la soluzione adatta a te.
            </p>
          </div>
          <ul class="contact-list">
            <li class="reveal">
              <div class="contact-list__icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="m4 7 8 6 8-6"></path>
                </svg>
              </div>

              <div class="contact-list__content">
                <span>Email</span>

                <a href="mailto:info@cieloartuso.com"> info@cieloartuso.com </a>
              </div>
            </li>

            <li class="reveal">
              <div class="contact-list__icon">
                <WhatsappIcon />
              </div>

              <div class="contact-list__content">
                <span>Whatsapp</span>

                <a href="https://wa.me/393488785699?text=Ciao%2C%20vorrei%20ricevere%20informazioni%20sui%20tuoi%20servizi."> 348 878 5699 </a>
              </div>
            </li>

            <li class="reveal">
              <div class="contact-list__icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"
                  ></path>
                  <circle cx="12" cy="10" r="2.5"></circle>
                </svg>
              </div>

              <div class="contact-list__content">
                <span>Dove</span>

                <p>Milano e da remoto ovunque</p>
              </div>
            </li>

            <li class="reveal">
              <div class="contact-list__icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              </div>

              <div class="contact-list__content">
                <span>Disponibilità</span>

                <p>Dal lunedì al venerdì</p>
              </div>
            </li>
          </ul>

          <div class="contact-info__note reveal">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.5 9.5 0 0 1-4-.9L3 21l1.8-4.6A8.5 8.5 0 1 1 21 11.5Z"
              ></path>
            </svg>

            <p>Prima call conoscitiva gratuita di 30 minuti e senza impegno.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="social-section">
      <div class="container social-section__grid">
        <div class="social-section__heading">
          <h2>Seguimi online</h2>

          <p>
            Puoi trovarmi anche sui miei canali social e vedere i miei progetti.
          </p>
        </div>

        <div class="social-list reveal">
          <a
            href="https://www.instagram.com/cieloartuso"
            target="_blank"
            rel="noopener noreferrer"
            class="social-item"
          >
            <span class="social-item__name">
              <InstagramIcon />
              Instagram
            </span>

            <span class="social-item__link">
              @cieloartuso
              <ArrowIcon />
            </span>
          </a>

          <a
            href="https://github.com/scepedanzale"
            target="_blank"
            rel="noopener noreferrer"
            class="social-item"
          >
            <span class="social-item__name">
              <GithubIcon />
              GitHub
            </span>

            <span class="social-item__link">
              Guarda i progetti
              <ArrowIcon />
            </span>
          </a>
        </div>
      </div>
    </section>

    <section id="form-section">
      <div class="container">
        <!-- FORM -->

        <div class="contact-form-wrapper reveal">
          <div class="section-heading contact-form__heading">
            <p class="eyebrow">Raccontami il progetto</p>

            <h2>Come posso aiutarti?</h2>

            <p>
              Raccontami pure la tua idea, anche se è ancora tutta da definire.
              Bastano poche informazioni per iniziare a capire insieme la
              direzione giusta!
            </p>
          </div>

          <form
            action="https://formspree.io/f/xzzdlbkq"
            method="POST"
            class="contact-form"
            id="contact-form"
          >
            <div class="contact-form__row">
              <div class="form-field">
                <label for="name">Nome e cognome</label>

                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="Come ti chiami?"
                  required
                />
              </div>

              <div class="form-field">
                <label for="email">Email</label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="nome@email.it"
                  required
                />
              </div>
            </div>

            <div class="contact-form__row">
              <div class="form-field">
                <label for="business"> Attività o azienda </label>

                <input
                  id="business"
                  name="business"
                  type="text"
                  autocomplete="organization"
                  placeholder="Nome dell’attività"
                />
              </div>

              <div class="form-field">
                <label for="service"> Di cosa hai bisogno? </label>

                <select id="service" name="service" required>
                  <option value="" selected disabled>
                    Di cosa hai bisogno?
                  </option>

                  <option value="landing-page">
                    Una landing page per promuovere un servizio o un progetto
                  </option>

                  <option value="nuovo-sito">
                    Un nuovo sito web con più pagine
                  </option>

                  <option value="rifacimento-sito">
                    Rifare o migliorare un sito già esistente
                  </option>

                  <option value="web-app">
                    Uno strumento su misura per gestire la mia attività
                  </option>

                  <option value="manutenzione">
                    Assistenza o modifiche su un sito esistente
                  </option>

                  <option value="intervento-singolo">
                    Intervento singolo su un sito esistente
                  </option>

                  <option value="consulenza">
                    Un confronto per capire quale soluzione scegliere
                  </option>

                  <option value="altro"> Altro </option>
                </select>
              </div>
            </div>

            <div class="form-field">
              <label for="website">
                Sito attuale
                <span>facoltativo</span>
              </label>

              <input
                id="website"
                name="website"
                type="url"
                autocomplete="url"
                placeholder="https://..."
              />
            </div>

            <div class="form-field">
              <label for="message"> Parlami del progetto </label>

              <textarea
                id="message"
                name="message"
                rows="7"
                placeholder="Cosa vorresti realizzare o migliorare? Qual è il problema principale del sito attuale?"
                required></textarea>
            </div>

            <label class="form-checkbox">
              <input type="checkbox" name="privacy" required />

              <span>
                Ho letto e accetto la
                <a class="link" href="/privacy-policy"> privacy policy </a>.
              </span>
            </label>

            <div class="contact-form__footer">
              <button type="submit" class="button button--primary">
                Invia la richiesta
                <ArrowIcon />
              </button>

              <p>Riceverai risposta entro 24 ore</p>
            </div>
            <p class="contact-form__status" aria-live="polite" role="status">
            </p>
          </form>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector("#contact-form");
  const params = new URLSearchParams(window.location.search);
  const serviceParam = params.get("service");

  if (form instanceof HTMLFormElement && serviceParam) {
    const serviceSelect = form.querySelector("#service");

    if (serviceSelect instanceof HTMLSelectElement) {
      serviceSelect.value = serviceParam;
    }
  }

  if (form instanceof HTMLFormElement) {
    const status = form.querySelector(".contact-form__status");
    const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!(submitButton instanceof HTMLButtonElement)) return;

      const originalButtonContent = submitButton.innerHTML;

      submitButton.disabled = true;
      submitButton.innerHTML = "<span>Invio in corso...</span>";

      if (status instanceof HTMLElement) {
        status.textContent = "";
        status.classList.remove(
          "contact-form__status--success",
          "contact-form__status--error",
        );
      }

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        const data = await response.json();

        if (!response.ok) {
          const errorMessage = data.errors
            ?.map((error: { message?: string }) => error.message)
            .filter(Boolean)
            .join(" ");

          throw new Error(
            errorMessage || "Non è stato possibile inviare il messaggio.",
          );
        }

        form.reset();

        if (status instanceof HTMLElement) {
          status.textContent =
            "Messaggio inviato! Grazie, ti risponderò entro 24 ore.";
          status.classList.add("contact-form__status--success");
        }

        submitButton.innerHTML = "<span>Messaggio inviato</span>";
      } catch (error) {
        if (status instanceof HTMLElement) {
          status.textContent =
            error instanceof Error
              ? error.message
              : "Si è verificato un errore. Riprova tra poco.";

          status.classList.add("contact-form__status--error");
        }

        submitButton.innerHTML = originalButtonContent;
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { capitalizeFirstLetter } from "../../utils/text";
import ArrowIcon from "../../components/icons/ArrowIcon.astro";
import { formatItalianDate } from "../../utils/date";

const posts = await getCollection("blog", ({ data }) => {
  console.log(data);
  return data.draft !== true;
});

const sortedPosts = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog | Cielo Artuso",
  description:
    "Guide e appunti pratici su siti web, restyling, SEO e manutenzione.",
  url: "https://www.cieloartuso.com/blog/",
  author: {
    "@type": "Person",
    name: "Cielo Artuso",
    url: "https://www.cieloartuso.com",
  },
  blogPost: sortedPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    url: `https://www.cieloartuso.com/blog/${post.id}/`,
    ...(post.data.cover && {
      image: new URL(post.data.cover, "https://www.cieloartuso.com").href,
    }),
  })),
};
---

<BaseLayout
  title="Blog | Cielo Artuso"
  description="Guide e appunti pratici su siti web, restyling, SEO e manutenzione."
   structuredData={blogSchema}
>
  <div class="blog-index">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Guide e FAQ</p>
        <h1>Blog sul mondo web</h1>
      </div>
    </section>

    <section class="container blog-index__list">
      {
        sortedPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-post-card-link reveal">
            <article class="blog-post-card">
              {post.data.cover && (
                <img
                  class="blog-post-card__image"
                  src={post.data.cover}
                  alt=""
                />
              )}

              <div class="blog-post-card__content">
                <div>
                  <p class="eyebrow">{capitalizeFirstLetter(post.data.tag)}</p>
                  <h2 class="blog-post-card__title">{post.data.title}</h2>
                </div>

                <p class="blog-post-card__description">
                  {post.data.description}
                </p>

                <div class="blog-post-card__meta">
                  <span>{formatItalianDate(post.data.date)}</span>
                  <span>{post.data.readingTime} min</span>
                </div>
              </div>

              <div class="blog-post-card__icon">
                <ArrowIcon />
              </div>
            </article>
          </a>
        ))
      }
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FacebookIcon from "../../components/icons/FacebookIcon.astro";
import MailIcon from "../../components/icons/MailIcon.astro";
import LinkIcon from "../../components/icons/LinkIcon.astro";
import { formatItalianDate } from "../../utils/date";
import { capitalizeFirstLetter } from "../../utils/text";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    console.log(data);
    return data.draft !== true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);

const { post } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings.filter((heading) => heading.depth === 2);

const currentUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(post.data.title);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: currentUrl,
  author: {
    "@type": "Person",
    name: "Cielo Artuso",
    url: "https://www.cieloartuso.com",
  },
  publisher: {
    "@type": "Person",
    name: "Cielo Artuso",
    url: "https://www.cieloartuso.com",
  },
  ...(post.data.cover && {
    image: new URL(post.data.cover, Astro.site).href,
  }),
};
---

<BaseLayout
  title={`${post.data.title} | Cielo Artuso`}
  description={post.data.description}
  structuredData={articleSchema}
  image={post.data.cover}
  imageAlt={post.data.title}
  type="article"
  publishedTime={post.data.date}
>
  <article class="blog-post">
    <header class="blog-post__header">
      <div class="container">
        <Breadcrumb activePage={post.data.title} />

        <h1>{post.data.title}</h1>

        <p class="blog-post__meta">
          <span>{capitalizeFirstLetter(post.data.tag)}</span>
          <span>{formatItalianDate(post.data.date)}</span>
          <span>{post.data.readingTime} min di lettura</span>
        </p>

        {
          post.data.cover && (
            <img class="blog-post__cover" src={post.data.cover} alt={post.data.title} />
          )
        }
      </div>
    </header>

    <div class="container blog-post__layout">
      <div class="blog-post__sidebar">
        {
          toc.length > 0 && (
            <aside
              class="blog-post__toc reveal"
              aria-label="Indice dei contenuti"
            >
              <p>Indice</p>

              <nav>
                {toc.map((heading, i) => (
                  <a href={`#${heading.slug}`}>
                    {i + 1}. {heading.text}
                  </a>
                ))}
              </nav>
            </aside>
          )
        }

        <aside class="blog-post__share reveal" aria-label="Condividi articolo">
          <p>Condividi</p>

          <div>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Condividi su Facebook"
            >
              <FacebookIcon />
            </a>

            <a
              href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
              aria-label="Condividi via email"
            >
              <MailIcon />
            </a>

            <button
              type="button"
              data-copy-link={currentUrl}
              aria-label="Copia il link dell’articolo"
            >
              <LinkIcon />
            </button>
          </div>
        </aside>
      </div>

      <div class="blog-post__content">
        <Content />
        <div class="blog-post__share reveal" aria-label="Condividi articolo">
          <p>Condividi l'articolo!</p>

          <div>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Condividi su Facebook"
            >
              <FacebookIcon />
            </a>

            <a
              href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
              aria-label="Condividi via email"
            >
              <MailIcon />
            </a>

            <button
              type="button"
              data-copy-link={currentUrl}
              aria-label="Copia il link dell’articolo"
            >
              <LinkIcon />
            </button>
          </div>
        </div>
      </div>
    </div>
  </article>

  <section class="related-posts">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Continua a leggere</p>
        <h2>Articoli consigliati</h2>
      </div>

      <div class="related-posts__grid">
        {
          allPosts
            .filter((item) => item.id !== post.id)
            .slice(0, 3)
            .map((item, i) => (
              <a
                href={`/blog/${item.id}`}
                class={`related-post reveal ${i > 0 && "d" + i}`}
              >
                <div class="related-post__image">
                  <img src={item.data.cover} alt="" />
                </div>

                <div class="related-post__content">
                  <div class="related-post__meta">
                    <span>{capitalizeFirstLetter(item.data.tag)}</span>
                    <span>{item.data.readingTime} min</span>
                  </div>

                  <h3>{item.data.title}</h3>
                </div>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll("[data-copy-link]");

    buttons.forEach((button) => {
      button.addEventListener("click", async () => {
        const url = button.getAttribute("data-copy-link");

        if (!url) return;

        await navigator.clipboard.writeText(url);
        button.textContent = "Link copiato";
      });
    });
  </script>
</BaseLayout>

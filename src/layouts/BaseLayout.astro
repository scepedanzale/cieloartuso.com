---
import "../css/global.css";
import StructuredData from "../components/StructuredData.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

const {
  title = "Cielo Artuso | Web developer",
  description = "Realizzo e rifaccio siti web per piccole attività, professionisti e brand locali.",
  structuredData,
  landing = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Cielo Artuso",
  url: "https://www.cieloartuso.com",
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="author" content="Cielo Artuso" />
    <meta name="description" content={description} />
    <meta name="keywords" content="sviluppatore web, " />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />

    <title>{title}</title>

    <StructuredData data={websiteSchema} />

    {
      structuredData &&
        (Array.isArray(structuredData) ? (
          structuredData.map((data) => (
            <script
              type="application/ld+json"
              set:html={JSON.stringify(data)}
            />
          ))
        ) : (
          <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
          />
        ))
    }

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");

      const theme =
        savedTheme === "light" || savedTheme === "dark" ? savedTheme : "light";

      document.documentElement.dataset.theme = theme;
    </script>

    <script is:inline>
      window.loadGoogleAnalytics = function () {
        if (window.__gaLoaded) return;

        window.__gaLoaded = true;

        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-8GNB16M8F9";

        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];

        function gtag() {
          window.dataLayer.push(arguments);
        }

        window.gtag = gtag;

        gtag("js", new Date());
        gtag("config", "G-8GNB16M8F9", {
          anonymize_ip: true,
        });
      };
    </script>
  </head>

  <body>
    <Header landing={landing} />

    <main>
      <slot />
    </main>

    <Footer landing={landing} />

    <CookieBanner />
    
    <script>
      const revealElements = document.querySelectorAll(".reveal");

      const observer = new IntersectionObserver(
        (entries) => {
          console.log("Observer chiamato:", entries);

          entries.forEach((entry) => {
            console.log(
              "Elemento:",
              entry.target,
              "isIntersecting:",
              entry.isIntersecting,
            );

            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0,
          rootMargin: "0px 0px -50px 0px",
        },
      );

      revealElements.forEach((element) => {
        observer.observe(element);
      });
    </script>
  </body>
</html>

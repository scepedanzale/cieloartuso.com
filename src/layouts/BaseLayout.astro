---
import "../css/global.css";
import StructuredData from "../components/StructuredData.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

// Immagine di condivisione predefinita (1200x630)
const DEFAULT_OG_IMAGE = "/images/site/og-image.jpg";

const {
  title = "Cielo Artuso | Web developer",
  description = "Realizzo e rifaccio siti web per piccole attività, professionisti e brand locali.",
  structuredData,
  landing = false,
  // Open Graph: immagine di anteprima, tipo di contenuto e data (solo articoli)
  image = DEFAULT_OG_IMAGE,
  imageAlt = title,
  type = "website",
  publishedTime,
  // Pagine da escludere dai motori di ricerca (landing, 404)
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Cielo Artuso",
  url: "https://www.cieloartuso.com",
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="author" content="Cielo Artuso" />
    <meta name="description" content={description} />
    <meta name="keywords" content="sviluppatore web, " />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Cielo Artuso" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      image === DEFAULT_OG_IMAGE && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <title>{title}</title>

    <StructuredData data={websiteSchema} />

    {
      structuredData &&
        (Array.isArray(structuredData) ? (
          structuredData.map((data) => (
            <script
              type="application/ld+json"
              set:html={JSON.stringify(data)}
            />
          ))
        ) : (
          <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
          />
        ))
    }

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");

      const theme =
        savedTheme === "light" || savedTheme === "dark" ? savedTheme : "light";

      document.documentElement.dataset.theme = theme;
    </script>

    <script is:inline>
      window.loadGoogleAnalytics = function () {
        if (window.__gaLoaded) return;

        window.__gaLoaded = true;

        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-8GNB16M8F9";

        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];

        function gtag() {
          window.dataLayer.push(arguments);
        }

        window.gtag = gtag;

        gtag("js", new Date());
        gtag("config", "G-8GNB16M8F9", {
          anonymize_ip: true,
        });
      };
    </script>
  </head>

  <body>
    <Header landing={landing} />

    <main>
      <slot />
    </main>

    <Footer landing={landing} />

    <CookieBanner />
    
    <script>
      const revealElements = document.querySelectorAll(".reveal");

      const observer = new IntersectionObserver(
        (entries) => {
          console.log("Observer chiamato:", entries);

          entries.forEach((entry) => {
            console.log(
              "Elemento:",
              entry.target,
              "isIntersecting:",
              entry.isIntersecting,
            );

            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0,
          rootMargin: "0px 0px -50px 0px",
        },
      );

      revealElements.forEach((element) => {
        observer.observe(element);
      });
    </script>
  </body>
</html>
